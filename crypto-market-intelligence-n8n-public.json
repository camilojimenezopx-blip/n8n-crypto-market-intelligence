        224,
        112
      ],
      "notes": "Edit thresholds here. Demonstration thresholds, not investment rules. Enable AI after testing. Select a destination spreadsheet/tab and enable the Sheets node + flag. Add Telegram credential/chat ID, enable both Telegram nodes + flag. Draft is unpublished."
    },
    {
      "parameters": {},
      "id": "9d5f3c55-241a-46d1-b9c4-0b75861f6886",
      "name": "Manual Preview",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/coins/markets",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "vs_currency",
              "value": "usd"
            },
            {
              "name": "ids",
              "value": "bitcoin,ethereum"
            },
            {
              "name": "sparkline",
              "value": "false"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "02f4b52a-76c9-4e65-9516-fc1ca2d1e820",
      "name": "Fetch BTC + ETH - CoinGecko",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        112
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('Monitor Settings').first().json;\nconst input=$input.first().json;\nconst body=Array.isArray(input.body)?input.body:[];\nconst assets=['bitcoin','ethereum'].map(id=>{\n const c=body.find(x=>x.id===id)||{};\n return {symbol:id==='bitcoin'?'BTC':'ETH',price_usd:c.current_price,change_24h_pct:c.price_change_percentage_24h,volume_24h_usd:c.total_volume,market_cap_usd:c.market_cap,high_24h:c.high_24h,low_24h:c.low_24h,source:'CoinGecko',volume_basis:'aggregate quote USD',source_updated_at:c.last_updated,observed_at:cfg.observed_at,degraded:false};\n});\nconst finite=v=>typeof v==='number'&&Number.isFinite(v);\nconst primary_ok=assets.every(a=>finite(a.price_usd)&&a.price_usd>0&&finite(a.change_24h_pct)&&finite(a.volume_24h_usd)&&a.volume_24h_usd>=0&&finite(a.high_24h)&&finite(a.low_24h)&&a.low_24h>0&&a.high_24h>=a.low_24h&&Number.isFinite(Date.parse(a.source_updated_at))&&(Date.parse(cfg.observed_at)-Date.parse(a.source_updated_at))<=cfg.max_age_minutes*60000&&(Date.parse(cfg.observed_at)-Date.parse(a.source_updated_at))>=-120000);\nreturn [{json:{assets,primary_ok}}];"
      },
      "id": "447089b7-18c0-4ed0-85c7-6c678c9795e2",
      "name": "Map + Check Primary Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        352
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.primary_ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "64261108-fb86-45bf-af03-9be47535c7fa",
      "name": "Primary Complete + Fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const incoming=$input.all().flatMap(x=>Array.isArray(x.json.assets)?x.json.assets:[x.json]);\nreturn incoming.map(a=>{\nconst errors=[];const fin=v=>typeof v==='number'&&Number.isFinite(v);\nif(!['BTC','ETH'].includes(a.symbol))errors.push('Unsupported/missing symbol');\nfor(const k of ['price_usd','change_24h_pct','volume_24h_usd','high_24h','low_24h'])if(!fin(a[k]))errors.push('Missing or invalid '+k);\nif(!(a.price_usd>0)||!(a.low_24h>0)||!(a.high_24h>=a.low_24h)||!(a.volume_24h_usd>=0))errors.push('Invalid price, volume or range');\nreturn {json:{...a,valid:errors.length===0,validation_errors:errors,error_stage:'market_validation'}};\n});"
      },
      "id": "fbde0602-3f53-41fd-a238-d1705a088292",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{symbol:'BTC',product:'BTC-USD'}},{json:{symbol:'ETH',product:'ETH-USD'}}];"
      },
      "id": "429faba1-1abf-4550-9050-a03082c6ae82",
      "name": "Prepare Fallback Products",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        688
      ],
      "notes": "Triggered by primary HTTP failure, missing required fields or stale data. Replaces the entire snapshot so sources do not mix."
    },
    {
      "parameters": {
        "url": "={{ 'https://api.exchange.coinbase.com/products/' + $json.product + '/stats' }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "b2961215-7602-4757-9071-c8d99c64e69c",
      "name": "Fallback - Coinbase 24h Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        688
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('Monitor Settings').first().json;\nreturn $input.all().map((item,i)=>{\nconst d=item.json.body||{};const p=$('Prepare Fallback Products').itemMatching(i).json;\nconst num=v=>v===null||v===undefined||v===''?null:Number(v);\nconst price=num(d.last),open=num(d.open),volume=num(d.volume);\nreturn {json:{symbol:p.symbol,price_usd:price,change_24h_pct:open>0&&price>0?(price/open-1)*100:null,volume_24h_usd:volume!==null&&price>0?volume*price:null,market_cap_usd:null,high_24h:num(d.high),low_24h:num(d.low),source:'Coinbase Exchange',volume_basis:'single exchange base volume x last price (USD estimate)',source_updated_at:null,observed_at:cfg.observed_at,degraded:true,freshness:'receipt time only; source timestamp unavailable'},pairedItem:{item:i}};\n});"
      },
      "id": "5b5e8517-b790-4e6d-b1e2-074bf8e69df9",
      "name": "Normalize Exchange Fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        688
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg=$('Monitor Settings').first().json;\nreturn $input.all().map(({json:d})=>({json:{run_id:cfg.run_id,observed_at:cfg.observed_at,error_stage:d.error_stage||'external_integration',symbol:d.symbol||'',error_message:Array.isArray(d.validation_errors)&&d.validation_errors.length?d.validation_errors.join('; '):String(d.error?.message||d.error||d.message||'Unexpected response or routing value').slice(0,400),notification_text:'CRYPTO MONITOR ERROR | run '+cfg.run_id+' | '+(d.error_stage||'external integration')+' | '+(d.symbol||'')+'. Inspect the n8n execution for details.'}}));"
      },
      "id": "c121b556-9886-4260-8f54-08d951bf9a13",
      "name": "Build Error Notification",
