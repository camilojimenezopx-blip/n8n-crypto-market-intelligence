      "id": "0b824e4a-5208-4252-ac3f-b85017f0abc2",
      "name": "Calculate Price Change Signal",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1328,
        80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "vol-turnover_24h_pct",
              "name": "turnover_24h_pct",
              "value": "={{ $json.market_cap_usd > 0 ? 100 * $json.volume_24h_usd / $json.market_cap_usd : null }}",
