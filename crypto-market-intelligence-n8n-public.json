    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "prompt-ai_prompt",
              "name": "ai_prompt",
              "value": "={{ 'Write a concise market-monitoring summary using only this JSON. State source, coverage, fallback limitations, and threshold reasons. Do not invent events, forecast prices, or recommend trades. Describe range as a volatility proxy and turnover as activity, not a volume spike. Do not change calculated risk labels. JSON: ' + JSON.stringify($json) }}",
