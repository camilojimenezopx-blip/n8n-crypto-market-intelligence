      "id": "11707cc1-8032-4b16-8269-bd210625fe07",
      "name": "Calculate Volume Activity",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1328,
        352
      ],
      "notes": "Turnover = 24h aggregate volume / market cap. Activity proxy only; not a volume-spike calculation. Unavailable for exchange-only fallback; never treated as zero."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "range-range_24h_pct",
              "name": "range_24h_pct",
              "value": "={{ 100 * ($json.high_24h - $json.low_24h) / $json.price_usd }}",
              "type": "number"
            },
            {
              "id": "range-volatility_signal",
              "name": "volatility_signal",
              "value": "={{ 100 * ($json.high_24h - $json.low_24h) / $json.price_usd >= $('Monitor Settings').first().json.high_range_pct ? 'high' : 100 * ($json.high_24h - $json.low_24h) / $json.price_usd >= $('Monitor Settings').first().json.watch_range_pct ? 'watch' : 'normal' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5ccc149d-0c6d-4e44-9f5f-eae1fe615d81",
      "name": "Calculate 24h Range Proxy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1328,
        608
      ],
      "notes": "Volatility proxy = (24h high - 24h low) / current price × 100. This is not standard deviation or annualized realized volatility."
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json:a})=>{\nconst reasons=[];\nif(a.price_signal!=='normal')reasons.push('24h price move '+a.change_24h_pct.toFixed(2)+'%');\nif(a.volatility_signal!=='normal')reasons.push('24h range proxy '+a.range_24h_pct.toFixed(2)+'%');\nif(a.volume_signal==='elevated')reasons.push('Elevated volume / market cap turnover');\nif(a.degraded)reasons.push('Fallback exchange data; aggregate turnover unavailable; freshness unverified');\nconst risk=a.price_signal==='high'||a.volatility_signal==='high'?'high-risk':a.price_signal==='watch'||a.volatility_signal==='watch'||a.volume_signal==='elevated'||a.degraded?'watch':'normal';\nreturn {json:{...a,risk,reasons:reasons.length?reasons:['Within configured demonstration thresholds']}};\n});"
      },
      "id": "2f1ad806-4d50-4140-8dda-1583c82c3b18",
      "name": "Classify + Explain Signals",
