    {
      "parameters": {
        "jsCode": "const original=$('Prepare AI-Ready Brief').first().json;\nconst data=$input.first().json;\nconst text=Array.isArray(data.output)?data.output.flatMap(x=>x.content||[]).filter(x=>x.type==='output_text').map(x=>x.text).join('\\n'):'';\nconst aiOk=typeof text==='string'&&text.trim().length>0&&!data.error;\nreturn [{json:{...original,summary:aiOk?text.trim():original.deterministic_summary,summary_mode:aiOk?'AI-generated (review required)':'deterministic',ai_error:Boolean(data.error)}}];"
      },
      "id": "aeb471ae-cc3a-492d-ae70-46d28fee7ea1",
      "name": "Resolve AI or Factual Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2864,
        608
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;return s.assets.map(a=>({json:{record_id:s.snapshot_id+'|'+a.symbol,run_id:s.run_id,observed_at:s.observed_at,symbol:a.symbol,source:a.source,price_usd:a.price_usd,change_24h_pct:a.change_24h_pct,volume_24h_usd:a.volume_24h_usd,volume_basis:a.volume_basis,turnover_24h_pct:a.turnover_24h_pct??'',range_24h_pct:a.range_24h_pct,risk:a.risk,reasons:a.reasons.join('; '),coverage:s.coverage,summary_mode:s.summary_mode,summary:s.summary}}));"
      },
