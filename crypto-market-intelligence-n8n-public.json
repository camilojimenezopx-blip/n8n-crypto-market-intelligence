            },
            {
              "id": "vol-volume_signal",
              "name": "volume_signal",
              "value": "={{ $json.market_cap_usd > 0 ? (100 * $json.volume_24h_usd / $json.market_cap_usd >= $('Monitor Settings').first().json.watch_turnover_pct ? 'elevated' : 'normal') : 'unavailable' }}",
