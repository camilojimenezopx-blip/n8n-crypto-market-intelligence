    },
    {
      "parameters": {
        "jsCode": "const cfg=$('Monitor Settings').first().json;\nconst assets=$input.all().map(x=>x.json).sort((a,b)=>a.symbol.localeCompare(b.symbol));\nconst missing=['BTC','ETH'].filter(s=>!assets.some(a=>a.symbol===s));\nconst snapshot_id=new Date(Math.floor(Date.parse(cfg.observed_at)/1800000)*1800000).toISOString();\nconst alerts=assets.filter(a=>a.alert_required);\nconst deterministic_summary=assets.map(a=>a.symbol+': $'+a.price_usd.toFixed(2)+' | 24h '+a.change_24h_pct.toFixed(2)+'% | range '+a.range_24h_pct.toFixed(2)+'% | '+a.risk.toUpperCase()+' | '+a.source+' | '+a.reasons.join('; ')).join('\\n')+(missing.length?'\\nINCOMPLETE COVERAGE: '+missing.join(', '):'')+'\\nRange is a volatility proxy. Monitoring only; no trading recommendations.';\nreturn [{json:{run_id:cfg.run_id,observed_at:cfg.observed_at,snapshot_id,assets,missing_symbols:missing,coverage:assets.length+'/2',alert_required:alerts.length>0||missing.length>0,deterministic_summary}}];"
      },
      "id": "db1c1ff3-42ff-445b-9c22-05f556de5505",
      "name": "Build Market Snapshot",
